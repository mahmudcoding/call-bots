{
  "name": "call-bots",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Put any number of guests into an Aloqa call — real WebRTC audio and video from synthetic capture devices",
  "bin": {
    "call-bots": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs ui",
    "build:app": "node scripts/build-macos-app.mjs",
    "release:mac": "node scripts/release-macos.mjs",
    "doctor": "node src/cli.mjs doctor",
    "clean": "node src/cli.mjs clean",
    "postinstall": "node scripts/postinstall.mjs",
    "test:platforms": "node scripts/test-platforms.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:stop": "node scripts/test-stop.mjs",
    "voices": "node scripts/make-voices.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "~1.59.0"
  }
}
